# dunst - compact desktop notifications

[global]
    monitor = 0
    follow = mouse

    width = (220, 440)
    height = (0, 260)
    origin = top-right
    offset = (14, 42)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 7
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 380
    progress_bar_corner_radius = 3

    icon_position = left
    min_icon_size = 24
    max_icon_size = 40
    icon_corner_radius = 6
    text_icon_padding = 12

    frame_width = 2
    frame_color = "{color5}"
    separator_height = 0
    separator_color = frame
    gap_size = 8
    corner_radius = 8
    corners = all
    padding = 9
    horizontal_padding = 11

    font = JetBrains Mono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n<span size='smaller'>%b</span>"
    alignment = center
    vertical_alignment = center
    ellipsize = end
    show_age_threshold = 45
    ignore_newline = no

    sort = update
    stack_duplicates = true
    hide_duplicate_count = false
    indicate_hidden = yes
    show_indicators = yes
    history_length = 20
    browser = qutebrowser

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color8}"
    highlight = "{color5}"
    timeout = 3

[urgency_normal]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color5}"
    highlight = "{color2}"
    timeout = 6

[urgency_critical]
    background = "{color1}"
    foreground = "{foreground}"
    frame_color = "{color1}"
    highlight = "{color2}"
    timeout = 0

[volume]
    appname = volume
    timeout = 2

[brightness]
    appname = brightness
    timeout = 2

[sway]
    appname = sway
    timeout = 3

[screenshot]
    appname = screenshot
    timeout = 4

[wallpaper]
    appname = wallpaper
    timeout = 4

[clipboard]
    appname = clipboard
    timeout = 3

[notes]
    appname = notes
    timeout = 3

[system]
    appname = system
    timeout = 8
