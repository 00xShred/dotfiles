#!/usr/bin/env bash
# yabai: small, Sway-ish macOS setup for coding/Xcode sessions.
# Intentionally avoids SIP-only features so it works on a stock Mac.

# Global behavior
yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config window_insertion_point focused
yabai -m config split_ratio 0.50
yabai -m config auto_balance off

# Match Sway muscle memory: keyboard focus is explicit, mouse stays put.
yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off

# Usable mouse fallback: alt-drag move, alt-right-drag resize.
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# Tight Sway-like spacing.
yabai -m config window_gap 5
yabai -m config top_padding 3
yabai -m config bottom_padding 3
yabai -m config left_padding 3
yabai -m config right_padding 3

# No SIP-only visuals.
yabai -m config window_opacity off

# Keep reloads idempotent.
for label in \
  float-system-settings \
  float-calculator \
  float-activity-monitor \
  float-archive-utility \
  float-app-store \
  float-dialogs \
  xcode-to-2 \
  simulator-to-3 \
  browser-to-4; do
  yabai -m rule --remove "$label" 2>/dev/null || true
done

# Keep dialog/utility windows floating instead of poisoning the BSP tree.
yabai -m rule --add label='float-system-settings' app='^System Settings$' manage=off
yabai -m rule --add label='float-calculator' app='^Calculator$' manage=off
yabai -m rule --add label='float-activity-monitor' app='^Activity Monitor$' manage=off
yabai -m rule --add label='float-archive-utility' app='^Archive Utility$' manage=off
yabai -m rule --add label='float-app-store' app='^App Store$' manage=off
yabai -m rule --add label='float-dialogs' title='^(Open|Save|Export|Import|Preferences|Settings|About).*$' manage=off

# Swift/iOS workspaces. These are best-effort; moving across Spaces may depend on macOS/SIP version.
yabai -m rule --add label='xcode-to-2' app='^Xcode$' space=2
yabai -m rule --add label='simulator-to-3' app='^Simulator$' space=3
yabai -m rule --add label='browser-to-4' app='^(Zen|Safari|Google Chrome|Firefox)$' space=4
