# skhd: Sway-ish keyboard layer for yabai.
# Option/Alt is the window-manager modifier so Command stays native for macOS apps.

# Apps
alt - return : open -a Kitty
alt - b      : open -a Zen || open -a Safari
alt - e      : open ~
alt - d      : osascript -e 'tell application "System Events" to key code 49 using command down'

# Windows
alt - q : yabai -m window --close
alt - f : yabai -m window --toggle zoom-fullscreen
alt - v : yabai -m window --toggle float
alt - m : yabai -m window --minimize

# Focus windows, falling through to display focus at screen edges.
alt - h : yabai -m window --focus west  || yabai -m display --focus west
alt - j : yabai -m window --focus south || yabai -m display --focus south
alt - k : yabai -m window --focus north || yabai -m display --focus north
alt - l : yabai -m window --focus east  || yabai -m display --focus east

# Move windows in the tree, falling through to other displays.
alt + shift - h : yabai -m window --warp west  || yabai -m window --display west
alt + shift - j : yabai -m window --warp south || yabai -m window --display south
alt + shift - k : yabai -m window --warp north || yabai -m window --display north
alt + shift - l : yabai -m window --warp east  || yabai -m window --display east

# Resize like Sway mod+ctrl+h/j/k/l.
alt + ctrl - h : yabai -m window --resize left:-20:0  || yabai -m window --resize right:-20:0
alt + ctrl - j : yabai -m window --resize bottom:0:20 || yabai -m window --resize top:0:20
alt + ctrl - k : yabai -m window --resize top:0:-20  || yabai -m window --resize bottom:0:-20
alt + ctrl - l : yabai -m window --resize right:20:0  || yabai -m window --resize left:20:0

# BSP tree operations for when yabai chooses an awkward split.
alt - r           : yabai -m space --rotate 90
alt + shift - r   : yabai -m space --balance
alt - x           : yabai -m space --mirror x-axis
alt - y           : yabai -m space --mirror y-axis
alt - g           : yabai -m space --toggle gap
alt + shift - g   : yabai -m space --toggle padding

# Workspaces / Spaces.
alt - tab : yabai -m space --focus recent
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9

# Move window to Space. On some macOS versions this requires yabai scripting addition/SIP changes.
alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9

# Screenshots: copy/save an interactive region.
alt - s         : screencapture -i -c
alt + shift - s : screencapture -i ~/Desktop/screenshot-$(date +%Y%m%d-%H%M%S).png

# Reload this layer quickly.
alt + shift - c : launchctl kickstart -k gui/${UID}/com.koekeishiya.skhd; launchctl kickstart -k gui/${UID}/com.asmvik.yabai
