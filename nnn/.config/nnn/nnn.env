# ~/.config/nnn/nnn.env
# Environment configuration for nnn (Foot + Neovim + Leaf + Zathura)

export TERMINAL="${TERMINAL:-foot}"
export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-nvim}"

export NNN_TERMINAL="${TERMINAL:-foot}"
export NNN_FIFO="${XDG_RUNTIME_DIR:-/tmp}/nnn.fifo"
export NNN_PLUG='p:preview-tui;f:fzcd;s:finder;d:diffs;x:togglex;t:nmount'
export NNN_OPENER="$HOME/.config/nnn/plugins/nuke"
export GUI=1
export NNN_PREVIEWIMGPROG="chafa"

# Options:
# c: cli-only opener override disabled (allow GUI opener)
# E: internal edits in $EDITOR
# n: type-to-nav
# R: auto-refresh on change
# x: copy selection on path to system clipboard
export NNN_OPTS="EnRx"
export NNN_COLORS="2134"
export NNN_TRASH=1
export NNN_PAGER="less -R"
export NNN_BATSTYLE="numbers,changes"

# cd on quit wrapper function
n() {
    [ "${NNNLVL:-0}" -eq 0 ] || {
        echo "nnn is already running"
        return
    }

    export NNN_TMPFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.lastd"

    # -a auto-creates FIFO for preview-tui
    command nnn -a "$@"

    if [ -f "$NNN_TMPFILE" ]; then
        . "$NNN_TMPFILE"
        rm -f "$NNN_TMPFILE" > /dev/null
    fi
}
