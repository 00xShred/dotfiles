# ~/.config/kanshi/config

profile "Docked" {
    output "eDP-1" disable

    # 1. Acer (Vertical Left)
    output "Acer Technologies KG271 TF5EE0058511" enable position 0,0 mode 1920x1080@60.00Hz transform 90

    # 2. Samsung (Right)
    output "Samsung Electric Company Smart M50D H1AK500000" enable position 1080,350 mode 1920x1080@60.00Hz
}

profile "Laptop" {
    output "eDP-1" enable mode 1920x1200@60.09600
}
