# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ZATHURA CONFIGURATION
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# --- 1. THEMES & COLOR ---
include "theme-sepia"
set recolor "false"
set recolor-keephue "true"
set recolor-reverse-video "true"

# --- 2. LOOK & FEEL ---
set font "JetBrains Mono Nerd Font 11"
# Add this to section 2
set statusbar-basename "true"
set window-title-basename "true"
set guioptions "svh"

# Padding
set statusbar-h-padding 10
set statusbar-v-padding 12

# --- 3. CLIPBOARD & SELECTION ---
set selection-clipboard clipboard

# --- 4. BEHAVIOR ---
set scroll-page-aware "true"
set scroll-full-overlap 0.01
set scroll-step 100
set adjust-open "best-fit"
set search-hadjust "true"
set zoom-min 10
set zoom-max 1000
set zoom-step 10
set render-loading "false"
set scroll-step 50

# --- 5. SYNCTEX ---
set synctex true
set synctex-editor-command "nvim --server $NVIM --remote-send '<C-\><C-N>:%l<CR>'"

# --- 6. KEYBINDINGS ---
map + zoom in
map - zoom out

map b toggle_statusbar
map r rotate rotate-cw
map R reload
map <Tab> toggle_index

# Themes: d beige, c black, D original pdf colors
map d exec "/home/0xShred/.config/zathura/theme.sh beige"
map D exec "/home/0xShred/.config/zathura/theme.sh orig"
