# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ZATHURA CONFIGURATION
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# --- 1. PYWAL INTEGRATION ---
include "/home/gabriel/.cache/wal/zathurarc"

# --- 2. LOOK & FEEL ---
set font "JetBrains Mono Nerd Font 11"

# Hiding scrollbars for a cleaner look (similar to your kitty hide_window_decorations)
set guioptions "sv"

# Padding
set statusbar-h-padding 10
set statusbar-v-padding 10

# --- 3. CLIPBOARD & SELECTION ---
# Use the clipboard (Ctrl+C/V) instead of primary selection (Mouse select)
set selection-clipboard clipboard

# --- 4. BEHAVIOR ---
set scroll-page-aware "true"
set smooth-scroll "true"
set scroll-full-overlap 0.01
set scroll-step 100

# Zoom settings
set zoom-min 10
set zoom-max 1000
set zoom-step 10

# Render settings
set render-loading "false"
set scroll-step 50

# --- 5. SYNCTEX ---
set synctex true
set synctex-editor-command "nvr --remote-silent +%{line} %{input}"

# --- 6. KEYBINDINGS ---
map z zoom in
map Z zoom out

map i recolor
map b toggle_statusbar

map R reload
